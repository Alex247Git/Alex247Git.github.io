---
import type { PortfolioProps } from '@templates/Portfolio/portfolio'
import Portfolio from '@templates/Portfolio/Portfolio.astro'

// Your layout, including menu and footer
const layout: PortfolioProps['layout'] = {
    seo: {
        title: 'Alex | Software Engineer Portfolio',
        url: 'https://Alex247Git.github.io/',
        description: 'Software Engineer specializing in modern web development.',
        faviconUrl: '/logo.svg' 
    },
    menu: {
        logo: {
            html: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>'
        }
    },
    // Empty config: footer content is provided via the "footer" slot below
    footer: {}
}

// Your hero section
const hero: PortfolioProps['hero'] = {
    heading: 'Hey, I\'m Alex 👋',
    subHeading: 'Software Engineer • Tech Enthusiast'
}

const aboutMe: PortfolioProps['aboutMe'] = {
    title: 'Skills',
    text: `Passionate Software Engineer with experience in full-stack web development and a strong foundation in multiple programming languages. I love building interactive and user-friendly applications.`,
    services: [
        'Javascript (React & Node.js)',
        'HTML & CSS',
        'C',
        'Python',
        'Java',
        'Git & GitHub Actions',
        'UI/UX Design',
        'SEO Optimization'
    ].map(feature => ({
        icon: 'circle-check',
        color: 'var(--w-color-primary)',
        text: feature
    }))
}

const myWork: PortfolioProps['myWork'] = {
    title: 'My Projects',
    items: [
        {
            href: 'https://github.com/Alex247Git/autonomous-firefighting-simulation',
            img: {
                src: `/img/logo.svg`,
                alt: 'Autonomous Firefighting Simulation',
                width: 500,
                height: 250
            },
            title: 'Autonomous Python Firefighting Simulation',
            text: 'An autonomous Python firefighting simulation project showcasing automated fire detection and extinguishing capabilities.'
        },
        {
            href: 'https://github.com/Alex247Git/jobsearch',
            img: {
                src: `/img/logo.svg`,
                alt: 'Job Search Platform',
                width: 500,
                height: 250
            },
            title: 'Job Search Platform',
            text: 'A full-stack job search platform built with a React (MUI) frontend and an Express/MySQL backend, featuring JWT authentication, personalized job recommendations, real-time messaging and ratings.'
        },
    ]
}

---

<Portfolio
    layout={layout}
    hero={hero}
    aboutMe={aboutMe}
    myWork={myWork}
>
    <div slot="menu">
        <a href="https://github.com/Alex247Git" target="_blank">GitHub</a>
    </div>
    <div slot="footer">
        <p style="text-align: center; margin: 0; padding: 1rem 0; font-size: 0.875rem; opacity: 0.7;">
            © 2026 Alex. All rights reserved. | Created by <a href="https://github.com/Alex247Git" target="_blank" style="color: var(--w-color-primary, #4176FF); text-decoration: none; font-weight: 600;">Alex</a>
        </p>
    </div>
</Portfolio>

<style is:global>
    /* Center all content */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Center text in sections */
    main section {
        text-align: center;
    }

    /* Center the About Me section */
    section .me {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    /* Hero center */
    section > :first-child {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    /* Extra top spacing for hero */
    section:first-of-type {
        padding-top: 6rem;
    }

    /* Extra bottom spacing before footer */
    section:last-of-type {
        padding-bottom: 4rem;
    }

    /* Footer slot styling */
    [slot="footer"] {
        background: rgba(0, 0, 0, 0.1);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1.5rem 0;
    }
</style>