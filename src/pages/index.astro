---
import type { PortfolioProps } from '@templates/Portfolio/portfolio'
import Portfolio from '@templates/Portfolio/Portfolio.astro'

// Your layout, including menu and footer
const layout: PortfolioProps['layout'] = {
    seo: {
        title: 'Alex | Software Engineer Portfolio',
        url: 'https://Alex247Git.github.io/',
        description: 'Software Engineer specializing in modern web development.',
        faviconUrl: '/logo.svg' 
    },
    menu: {
        logo: {
            html: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>'
        }
    },
    // Footer band styled via .site-footer (see <style> below); content comes from the "footer" slot
    footer: {
        className: 'site-footer'
    }
}

// Your hero section
const hero: PortfolioProps['hero'] = {
    heading: 'Hey, I\'m Alex 👋',
    subHeading: 'Software Engineer • Tech Enthusiast'
}

const aboutMe: PortfolioProps['aboutMe'] = {
    title: 'Skills',
    text: `Passionate Software Engineer with experience in full-stack web development and a strong foundation in multiple programming languages. I love building interactive and user-friendly applications.`,
    services: [
        'Javascript (React & Node.js)',
        'HTML & CSS',
        'C',
        'Python',
        'Java',
        'Git & GitHub Actions',
        'UI/UX Design',
        'SEO Optimization'
    ].map(feature => ({
        icon: 'circle-check',
        color: 'var(--w-color-primary)',
        text: feature
    }))
}

const myWork: PortfolioProps['myWork'] = {
    title: 'My Projects',
    items: [
        {
            href: 'https://github.com/Alex247Git/autonomous-firefighting-simulation',
            img: {
                src: `/img/thumb-firefighting.svg`,
                alt: 'Autonomous Firefighting Simulation',
                width: 500,
                height: 250
            },
            title: 'Autonomous Python Firefighting Simulation',
            text: 'An autonomous Python firefighting simulation project showcasing automated fire detection and extinguishing capabilities.'
        },
        {
            href: 'https://github.com/Alex247Git/jobsearch',
            img: {
                src: `/img/thumb-jobsearch.svg`,
                alt: 'Job Search Platform',
                width: 500,
                height: 250
            },
            title: 'Job Search Platform',
            text: 'A full-stack job search platform built with a React (MUI) frontend and an Express/MySQL backend, featuring JWT authentication, personalized job recommendations, real-time messaging and ratings.'
        },
        {
            href: 'https://github.com/Alex247Git/alumni-career-map',
            img: {
                src: `/img/thumb-alumni.svg`,
                alt: 'Alumni Career Map',
                width: 500,
                height: 250
            },
            title: 'Alumni Career Map',
            text: 'A full-stack alumni career mapping platform with a PHP (Slim) + MySQL API, Leaflet map frontend, JWT authentication, jobs CRUD and Dockerized CI.'
        },
    ]
}

---

<Portfolio
    layout={layout}
    hero={hero}
    aboutMe={aboutMe}
    myWork={myWork}
>
    <div slot="menu">
        <a href="https://github.com/Alex247Git" target="_blank">GitHub</a>
        <a href="/blog/semantic-job-matching">Blog</a>
    </div>
    <div slot="footer">
        <p class="footer-credit">
            © 2026 Alex. All rights reserved. | Created by <a href="https://github.com/Alex247Git" target="_blank">Alex</a>
        </p>
    </div>
</Portfolio>

<!-- About Section -->
<section class="about-section">
    <h2>About Me</h2>
    <p class="about-text">
        I'm a Software Engineer from Greece with a passion for building full-stack web applications 
        and solving complex problems. I specialize in modern JavaScript (React, Node.js) and Python, 
        with experience in machine learning, data visualization, and cloud-native development.
    </p>
    <p class="about-text">
        Currently open to <strong>full-stack</strong> and <strong>software engineering roles</strong> — 
        remote or hybrid (Greece / EU). I thrive in collaborative environments where I can contribute 
        to meaningful products while growing as an engineer.
    </p>
    <div class="metrics-grid">
        <div class="metric">
            <span class="metric-number">34</span>
            <span class="metric-label">Tests</span>
        </div>
        <div class="metric">
            <span class="metric-number">0</span>
            <span class="metric-label">Vulnerabilities</span>
        </div>
        <div class="metric">
            <span class="metric-number">3</span>
            <span class="metric-label">Projects</span>
        </div>
        <div class="metric">
            <span class="metric-number">CI</span>
            <span class="metric-label">Green</span>
        </div>
    </div>
</section>

<section class="contact-section">
    <h2>📬 Let's Connect</h2>
    <p class="contact-blurb">
        I'm currently open to full-stack and software engineering roles — remote or
        hybrid (Greece / EU). If you'd like to talk about a role, a project, or just
        tech in general, my inbox is always open.
    </p>
    <div class="contact-links">
        <a href="mailto:AlexAdamos247@gmail.com" class="contact-link">
            ✉️ Email
        </a>
        <a href="https://www.linkedin.com/in/alexandros-adamos-227961331/" target="_blank" class="contact-link">
            💼 LinkedIn
        </a>
        <a href="https://github.com/Alex247Git" target="_blank" class="contact-link">
            🐙 GitHub
        </a>
    </div>
</section>

<style>
    .footer-credit {
        text-align: center;
        margin: 0;
        padding: 1rem 0;
        font-size: 0.875rem;
        opacity: 0.7;
    }

    .footer-credit a {
        color: var(--w-color-primary);
        text-decoration: none;
        font-weight: 600;
    }

    /* About section */
    .about-section {
        max-width: 60rem;
        margin: 0 auto;
        padding: 3rem 2rem;
        text-align: center;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .about-section h2 {
        font-size: 1.6rem;
        margin-bottom: 1rem;
    }

    .about-text {
        max-width: 45rem;
        margin: 0 auto 1rem;
        opacity: 0.85;
        line-height: 1.6;
    }

    .metrics-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .metric {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        min-width: 80px;
    }

    .metric-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--w-color-primary);
    }

    .metric-label {
        font-size: 0.8rem;
        opacity: 0.7;
        margin-top: 0.25rem;
    }

    /* Contact section */
    .contact-section {
        max-width: 60rem;
        margin: 0 auto;
        padding: 3rem 2rem 4rem;
        text-align: center;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .contact-section h2 {
        font-size: 1.6rem;
        margin-bottom: 1rem;
    }

    .contact-blurb {
        max-width: 40rem;
        margin: 0 auto 1.75rem;
        opacity: 0.85;
        line-height: 1.6;
    }

    .contact-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
    }

    .contact-link {
        display: inline-block;
        padding: 0.6rem 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

    .contact-link:hover {
        border-color: var(--w-color-primary);
        background: rgba(255, 255, 255, 0.05);
    }
</style>

<style is:global>
    /* Page-level overrides — scoped under main.container / .site-footer to avoid selector leaks */
    main.container {
        padding: 0 2rem;
    }

    main.container section {
        text-align: center;
    }

    main.container section:first-of-type {
        padding-top: 6rem;
    }

    main.container section:last-of-type {
        padding-bottom: 4rem;
    }

    /* Footer band (className passed through FooterProps) */
    .site-footer {
        background: rgba(0, 0, 0, 0.1);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1.5rem 0;
    }
</style>