        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
        overflow-x: auto;
        font-size: 0.875rem;
        line-height: 1.55;
    }

    .post code {
        font-family: ui-monospace, 'JetBrains Mono', Menlo, Consolas, monospace;
    }

